        "TXT_RCP_TANK", 
        "TXT_ITM_DESC_TANK", 
        "TXT_ITM_TANK", 
    }, 
    .uiStartingCost = 205u, 
    .uiMinCost = 68u, 
    .uiMaxCost = 1025u, 
    .uiActStart = 1u, 
    .uiActEnd = 4u, 
    .uiRarity = RulesTypes.eRarity.Uncommon, 
    .uiType = RulesTypes.ItemType.Strategic, 
    .Domain = RulesTypes.DomainSets.Military, 
    .uiHarvestType = RulesTypes.HarvestType.NoneOfTheAbove, 
    .Flags = (Flags.OnMarket | Flags.Craftable | Flags.Weapon), 
    .uiActivateCost = 0u, 
    .ActivateBuffs = {}, 
    .AddItemsOnConsume = 
    {
    }, 
    .uiGiveConsumeItemsForNumTurns = 0u, 
    .ActivateBuffsForImprovements = {}, 
    .AIAlignment =
    {
        [AIAlignment.Alignment.Prestige]     = 0i8,
        [AIAlignment.Alignment.Research]     = 0i8,
        [AIAlignment.Alignment.Masterpieces]     = 0i8,
        [AIAlignment.Alignment.Religion]     = 0i8,
        [AIAlignment.Alignment.Production]     = 0i8,
        [AIAlignment.Alignment.Offense]     = 5i8,
        [AIAlignment.Alignment.Defense]     = 5i8,
        [AIAlignment.Alignment.Food]     = 0i8,
        [AIAlignment.Alignment.Stone]     = 0i8,
        [AIAlignment.Alignment.Wood]     = 0i8,
        [AIAlignment.Alignment.Money]     = 0i8,
        [AIAlignment.Alignment.Happiness]     = 0i8,
        [AIAlignment.Alignment.Health]     = 0i8,
        [AIAlignment.Alignment.Wealth]     = 0i8,
        [AIAlignment.Alignment.Education]     = 0i8,
        [AIAlignment.Alignment.Security]     = 0i8,
        [AIAlignment.Alignment.Bias]     = 1i8,
        [AIAlignment.Alignment.Diplomacy]     = 0i8,
        [AIAlignment.Alignment.Housing]     = 0i8,
    },
};
