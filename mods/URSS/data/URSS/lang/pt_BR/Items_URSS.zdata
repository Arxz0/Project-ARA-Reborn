    .AIAlignment =
    {
        [AIAlignment.Alignment.Prestige]     = 0i8,
        [AIAlignment.Alignment.Research]     = 0i8,
        [AIAlignment.Alignment.Masterpieces]     = 0i8,
        [AIAlignment.Alignment.Religion]     = 0i8,
        [AIAlignment.Alignment.Production]     = 0i8,
        [AIAlignment.Alignment.Offense]     = 5i8,
        [AIAlignment.Alignment.Defense]     = 5i8,
        [AIAlignment.Alignment.Food]     = 0i8,
        [AIAlignment.Alignment.Stone]     = 0i8,
        [AIAlignment.Alignment.Wood]     = 0i8,
        [AIAlignment.Alignment.Money]     = 0i8,
        [AIAlignment.Alignment.Happiness]     = 0i8,
        [AIAlignment.Alignment.Health]     = 0i8,
        [AIAlignment.Alignment.Wealth]     = 0i8,
        [AIAlignment.Alignment.Education]     = 0i8,
        [AIAlignment.Alignment.Security]     = 0i8,
