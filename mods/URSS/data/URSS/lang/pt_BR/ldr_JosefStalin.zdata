    .FirstContact =
    {
        "Stalin recebe voc\xC3\xAA com um sorriso lento e o cachimbo na m\xC3\xA3o, e prop\xC3\xB5e um tratado que parece, \xC3\xA0 primeira vista, generoso.",
        "O l\xC3\xADder sovi\xC3\xA9tico escuta em sil\xC3\xAAncio, estudando voc\xC3\xAA como um enxadrista estuda o tabuleiro. \xC3\x89 imposs\xC3\xADvel saber o que ele est\xC3\xA1 pensando.",
