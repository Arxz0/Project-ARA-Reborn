{
    .Description = "+50% de Velocidade de Fabrica\xC3\xA7\xC3\xA3o nas Melhorias Militares",
    .SourceType = BuffSourceType.LeaderFeature,
    .TargetType = BuffTargetType.Improvement,
    .Scope = BuffScope.All,
    .Turns = 0u,
    .Attributes = @"ATTR(AtrImprovementDomainCheck(Military))ATTR",
    .Modifiers = @"MODS(ModMul(CraftRate, 0.50))MODS",
    .Flags = 0,
};

