schema Buffs;

// Grande Guerra Patriotica A - defesa da patria: forca dos exercitos terrestres dentro do proprio territorio
export BuffTemplateData buf_GreatPatrioticWar_A =
{
    .Description = "TXT_BUFF_ARMIESINTERRITORY_LAND_STRENGTH_MUL",
    .SourceType = BuffSourceType.LeaderFeature,
    .TargetType = BuffTargetType.Unit,
    .Scope = BuffScope.All,
    .Turns = 0u,
    .Attributes = @"ATTR(AtrRegionStatCheck(IsOwnedFlag, '=', 1.0) and AtrArmyTypeCheck(Land) and not AtrArmyFormationCheck(frm_Civilian))ATTR",
    .Modifiers = @"MODS(ModMul(Strength, 0.25))MODS",
    .Flags = 0,
};

// Grande Guerra Patriotica B - economia de guerra: fabricacao mais rapida nas Melhorias Militares
