        .uiAttack=0,
        .uiDefense=10
    },
    .uiProductionCost=30,
    .ItemCost=
    {
        .itm_Wood  = 3,
        .itm_Stone = 3,
        .itm_Iron  = 2,
        .itm_Steel = 2,
    },
