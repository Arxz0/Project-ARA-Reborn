schema ZNODataLibrary;

export Library Root =
{
    .Groups =
    {
        .RoadTemplates = { .Entries = { .rdt_Railroad = { "files/Railroad.zdata", "rdt_Railroad" }, }, },

        // Train Station: new improvement, a connection point (the game's list + imp_TrainStation), unlocked by Steam Engine.
        // Replaces the ConnectionPoints list and tch_SteamEngine: mods that replace the same entries conflict (see README, Compatibility).
        .Improvements = { .FromFiles = { "files/TrainStation.zdata" }, },
        .ConnectionPoints = { .Entries = { .Connections = { "files/ConnectionPoints.zdata", "export_ConnectionPointsData" }, }, },
        .Technologies = { .FromFiles = { "files/Tech_SteamEngine.zdata" }, },
    },
};
