export UnitTemplate unt_Pracinhas =
{
    .Name = "Pracinhas",
    .Description = "Rifle-armed ranged infantry of the Brazilian Expeditionary Force that works best when firing on enemy armies from range. Vulnerable to cavalry in combat.",
    .EncartaStrategy = "Infantry unique to Brazil, slightly stronger than other rifle infantry of its era. Position the Pracinhas to weaken enemy armies from range before melee. Beware of cavalry.",
    .EncartaHistory = "\xE2\x80\x9CPracinhas\xE2\x80\x9D was the affectionate nickname given to the soldiers of the Brazilian Expeditionary Force (FEB), sent by the Vargas government to fight alongside the Allies in the Second World War. More than 25,000 Brazilians crossed the Atlantic and fought in Italy between 1944 and 1945. Facing the cold of the Apennine winter, the Pracinhas took Monte Castello in February 1945 and Montese in April, and near Fornovo di Taro they accepted the surrender of an entire German division. Their insignia, a snake smoking a pipe, answered the old joke that it would be easier for a snake to smoke than for Brazil to go to war.",

    .Asset = "Rifleman",
    .AtlasID = "RedoubtInfantry",

