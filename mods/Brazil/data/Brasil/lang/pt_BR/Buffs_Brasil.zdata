{
    .Description = "TXT_BUFF_IMPROVEMENTDOMAIN_INDUSTRY_BUILDRATE_MUL", 
    .SourceType = BuffSourceType.LeaderFeature, 
    .TargetType = BuffTargetType.Improvement, 
    .Scope = BuffScope.All, 
    .Turns = 0u, 
    .Attributes = @"ATTR(AtrImprovementDomainCheck(Industry))ATTR", 
    .Modifiers = @"MODS(ModMul(BuildRate, 0.50))MODS", 
    .Flags = 0, 
};

