    .ActFlavorStrings = 
    {
        "Get\xC3\xBAlio Vargas, ga\xC3\xBA\x63ho de S\xC3\xA3o Borja, o olhar de todo um povo agora se volta para voc\xC3\xAA. Una as prov\xC3\xADncias dispersas sob uma s\xC3\xB3 vontade e lance as bases de uma na\xC3\xA7\xC3\xA3o que n\xC3\xA3o se curvar\xC3\xA1 mais \xC3\xA0s velhas oligarquias.",
        "Oper\xC3\xA1rios enchem as ruas e f\xC3\xA1\x62ricas se erguem onde antes s\xC3\xB3 havia lavouras. O Brasil est\xC3\xA1 mudando, e est\xC3\xA1 mudando \xC3\xA0 sua imagem. Mantenha o Estado forte e o povo ao seu lado, e o Brasil se tornar\xC3\xA1 a grande pot\xC3\xAAncia que sempre esteve destinado a ser.",
        "O petr\xC3\xB3leo \xC3\xA9 nosso, as usinas est\xC3\xA3o acesas e a na\xC3\xA7\xC3\xA3o fala com uma s\xC3\xB3 voz. Enquanto novas m\xC3\xA1quinas tomam a terra e os c\xC3\xA9us, \xC3\xA9 voc\xC3\xAA quem decidir\xC3\xA1 o que o Brasil ser\xC3\xA1. O que quer que venha a seguir, seu nome j\xC3\xA1 pertence \xC3\xA0 Hist\xC3\xB3ria.",
    },

    .Act2RankStrings = 
    {
        "Suas reformas s\xC3\xA3o celebradas dos pampas \xC3\xA0 Amaz\xC3\xB4nia, e o mundo agora olha para o Brasil com respeito.",
        "A\xC3\xA7o, leis trabalhistas e novas estradas: as bases de um Brasil moderno est\xC3\xA3o firmemente assentadas.",
        "O caminho foi duro e os inimigos foram muitos, mas o povo ainda chama pelo seu nome.",
